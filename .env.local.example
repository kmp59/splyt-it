# ──────────────────────────────────────────────────────────────────────────────
# Data mode  (copy this file to .env.local and fill in values)
# ──────────────────────────────────────────────────────────────────────────────
#
# VITE_DATA_MODE=local   → localStorage only, no Firebase needed.
#                           Demo groups/expenses are seeded automatically.
#                           Use any email + password to create an account.
#
# VITE_DATA_MODE=prod    → Firebase only (default when variable is unset).
#                           Fill in all VITE_FIREBASE_* vars below.
#
VITE_DATA_MODE=local

# ──────────────────────────────────────────────────────────────────────────────
# Firebase credentials  (only needed when VITE_DATA_MODE=prod)
# ──────────────────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
